<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#3b82f6"
                android:centerColor="#eff6ff"
                android:endColor="#ffffff"
                android:angle="270" />
